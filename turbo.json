{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "AI_PROVIDER",
    "GEMINI_API_KEY",
    "GEMINI_MODEL",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "MCP_SERVER_URL",
    "MCP_HOST",
    "MCP_PORT",
    "MCP_API_KEY",
    "CUSTOMS_BROKER_API_URL",
    "CUSTOMS_BROKER_ADDRESS",
    "CUSTOMS_BROKER_FEE_USDC",
    "IMPORTER_ADDRESS",
    "IMPORTER_PRIVATE_KEY",
    "MAX_PAYMENT_USDC",
    "HUMAN_APPROVAL_ABOVE_USDC",
    "X402_NETWORK",
    "LOG_LEVEL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
