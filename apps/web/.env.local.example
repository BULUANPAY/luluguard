AI_PROVIDER=gemini

# Gemini（AI_PROVIDER=gemini）
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# OpenAI（AI_PROVIDER=openai）
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5-mini

MCP_SERVER_URL=http://127.0.0.1:4020/mcp
MCP_API_KEY=replace-with-a-long-random-secret

# Optional overrides for the stdio vLEI JSON verification MCP.
# Defaults: pnpm --filter @luluguard/vlei-json-verify-mcp start, from workspace root.
# VLEI_VERIFY_MCP_COMMAND=pnpm
# VLEI_VERIFY_MCP_ARGS=["--filter","@luluguard/vlei-json-verify-mcp","start"]
# VLEI_VERIFY_MCP_CWD=/absolute/path/to/luluguard
