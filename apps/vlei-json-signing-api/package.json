{
  "name": "@repo/vlei-json-signing-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "dev": "pnpm run build && node --env-file-if-exists=../../.env --watch dist/index.js",
    "start": "node --env-file-if-exists=../../.env dist/index.js"
  },
  "dependencies": {
    "@repo/vlei-json-signing": "workspace:*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "typescript": "7.0.2"
  }
}
