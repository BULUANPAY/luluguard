CUSTOMS_BROKER_API_URL=http://127.0.0.1:4021
CUSTOMS_BROKER_FEE_USDC=0.01
CUSTOMS_BROKER_ADDRESS=0x0000000000000000000000000000000000000000

# Choose private-key or aws-kms. Use only a dedicated Base Sepolia test wallet.
IMPORTER_ADDRESS=0x0000000000000000000000000000000000000000
SIGNER_PROVIDER=private-key
IMPORTER_PRIVATE_KEY=0xYOUR_64_HEX_CHARACTER_TESTNET_PRIVATE_KEY

# AWS KMS alternative. The key must be asymmetric, SIGN_VERIFY, and ECC_SECG_P256K1.
AWS_PROFILE=YOUR_AWS_PROFILE
AWS_REGION=YOUR_AWS_REGION
AWS_KMS_KEY_ID=key/YOUR_KEY_ID
# AWS_KMS_ENDPOINT=http://127.0.0.1:4566

MAX_PAYMENT_USDC=1
MAX_DAILY_PAYMENT_USDC=5
MAX_PAYMENTS_PER_HOUR=5
HUMAN_APPROVAL_ABOVE_USDC=0

X402_NETWORK=eip155:84532
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true
# AUDIT_LOG_PATH=./logs/audit.jsonl
AUDIT_LOG_MAX_VALUE_LENGTH=8000
MCP_HOST=127.0.0.1
MCP_PORT=4020
MCP_API_KEY=replace-with-a-long-random-secret
POLICY_ADMIN_API_KEY=replace-with-a-separate-policy-admin-secret
