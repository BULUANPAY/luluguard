{
  "name": "@luluguard/importer-mcp",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/mcp-server.ts",
    "lint": "eslint .",
    "start": "node --env-file-if-exists=../../.env dist/src/mcp-server.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1119.0",
    "@modelcontextprotocol/sdk": "^1.17.3",
    "@repo/vlei-json-signing": "workspace:*",
    "@noble/curves": "^1.9.7",
    "@x402/core": "^2.23.0",
    "@x402/evm": "^2.23.0",
    "@x402/fetch": "^2.23.0",
    "express": "^5.2.1",
    "viem": "^2.56.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "tsx": "4.20.5",
    "typescript": "7.0.2"
  }
}
