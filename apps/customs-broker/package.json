{
  "name": "@luluguard/customs-broker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "lint": "eslint .",
    "start": "node --env-file-if-exists=../../.env dist/src/index.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@x402/core": "2.24.0",
    "@x402/evm": "2.24.0",
    "@x402/express": "2.24.0",
    "@x402/fetch": "2.24.0",
    "express": "5.2.1",
    "viem": "2.56.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "tsx": "4.20.5",
    "typescript": "7.0.2"
  }
}
