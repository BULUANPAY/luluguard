# Shared vLEI identity
VLEI_ROOT_SEED=replace-with-a-long-random-secret
VLEI_EXPECTED_ROOT_AID=replace-with-the-public-root-aid-derived-from-the-root-seed

# Web AI provider: gemini or openai
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna

# Web to Importer MCP connection
MCP_SERVER_URL=http://127.0.0.1:4020/mcp
MCP_HOST=127.0.0.1
MCP_PORT=4020
MCP_API_KEY=replace-with-a-long-random-secret
POLICY_ADMIN_API_KEY=replace-with-a-separate-policy-admin-secret
SANDBOX_SESSION_SECRET=replace-with-a-long-random-session-secret

# Optional overrides for the stdio vLEI JSON verification MCP.
# Defaults: pnpm --filter @luluguard/vlei-json-verify-mcp start, from workspace root.
# VLEI_VERIFY_MCP_COMMAND=pnpm
# VLEI_VERIFY_MCP_ARGS=["--filter","@luluguard/vlei-json-verify-mcp","start"]
# VLEI_VERIFY_MCP_CWD=/absolute/path/to/luluguard

# Customs broker
CUSTOMS_BROKER_API_URL=http://127.0.0.1:4021
CUSTOMS_BROKER_HOST=127.0.0.1
CUSTOMS_BROKER_PORT=4021
CUSTOMS_BROKER_ADDRESS=0x0000000000000000000000000000000000000000
CUSTOMS_BROKER_FEE_USDC=0.01
CUSTOMS_BROKER_QUOTE_TTL_SECONDS=300

# Importer signer. Use only a dedicated Base Sepolia test wallet.
IMPORTER_ADDRESS=0x0000000000000000000000000000000000000000
IMPORTER_LEI=8755001ELOZEL05BVX22
SIGNER_PROVIDER=private-key
IMPORTER_PRIVATE_KEY=0xYOUR_64_HEX_CHARACTER_TESTNET_PRIVATE_KEY

# AWS KMS signer alternative. The key must be asymmetric, SIGN_VERIFY, and ECC_SECG_P256K1.
AWS_PROFILE=YOUR_AWS_PROFILE
AWS_REGION=YOUR_AWS_REGION
AWS_KMS_KEY_ID=key/YOUR_KEY_ID
# AWS_KMS_ENDPOINT=http://127.0.0.1:4566

# Payment policy
MAX_PAYMENT_USDC=1
MAX_DAILY_PAYMENT_USDC=5
MAX_PAYMENTS_PER_HOUR=5
HUMAN_APPROVAL_ABOVE_USDC=0

# x402
X402_NETWORK=eip155:84532
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_FACILITATOR_TIMEOUT_MS=30000

# Audit and logging
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true
# AUDIT_LOG_PATH=./logs/audit.jsonl
AUDIT_LOG_MAX_VALUE_LENGTH=8000
